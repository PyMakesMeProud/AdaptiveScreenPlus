<?xml version="1.0" encoding="utf-8"?>
<!--
  副屏键盘（伪应用）—— 在封面屏上打字，字送进目标屏那些应用的光标处。

  为什么不做"自己画一套键盘"：中文根本没法在应用侧直接注入（`input text` 只认
  ASCII），所以这里走"用系统输入法打、按发送键推过去"这条路（见 KeyActivity 的说明）。
  于是这页的主体是一个输入框 —— 点一下它，用户平时用的输入法就起来了。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKeyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ext_key_title"
            android:textColor="#E6EAF2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ⓘ：功能 / 用法 / 注意事项 全在这里，界面里不铺说明文字 -->
        <TextView
            android:id="@+id/iKeyTop"
            style="@style/BetaInfoIcon"
            android:contentDescription="@string/ext_key_title" />

        <Button
            android:id="@+id/btnKeyClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_close"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvKeyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/ext_key_state_idle"
        android:textColor="#8C97A8"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etKeyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@drawable/ext_input"
        android:gravity="top|start"
        android:hint="@string/ext_key_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="4"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:textColor="#E6EAF2"
        android:textColorHint="#5A6474"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKeySend"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:background="@drawable/ext_btn_primary"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_send"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKeyEnter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_enter"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnKeyDel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_backspace"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnKeyClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_clear"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnKeyMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_key_mode_auto"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKeySpace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_space"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKeyTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_tab"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnKeyEsc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_esc"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
