<?xml version="1.0" encoding="utf-8"?>
<!--
  「投屏控制」（伪应用）的界面 —— 投在副屏上用（v3.16）。

  干的事：把内屏画面实时贴到中间那个 TextureView 上，手指在画面上点/拖，
  就按同一个比例换算成内屏坐标注进去（见 CastActivity 的触摸那一段）。

  ⚠ 尺寸按封面屏算：748×720px / d=1.5 ⇒ 约 498×414dp，扣掉挖孔顶下来的 66px
    和底部一点，能用的高度大概 380dp。所以顶栏压到 34dp，右侧操作列 78dp，
    中间那块画面尽量让它大（几何来历见 RULES §31.1；别按 2.125 算）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCast"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- 顶栏：标题 + ⓘ + 全屏 + 开始/停止 + 关闭。
         高度写在行上、子项 match_parent（RULES §16.4），小按钮显式 minWidth=0。
         全屏时这一整条连勾选行、右侧那列、状态行一起收起（见 CastActivity.setFullscreen）。 -->
    <LinearLayout
        android:id="@+id/rowCastTop"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCastTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ext_cast_title"
            android:textColor="#E6EAF2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ⓘ：功能 / 用法 / 注意事项 全在这里，界面上不铺说明文字 -->
        <TextView
            android:id="@+id/iCastTop"
            style="@style/BetaInfoIcon"
            android:contentDescription="@string/ext_cast_title" />

        <!-- 全屏：把整块屏让给画面。单向的 —— 全屏之后这一排控件自己也收起来，
             退出来靠"从画面最顶上往下拉"，会滑出一条「退出全屏」
             （见 CastActivity.dispatchTouchEvent）。 -->
        <Button
            android:id="@+id/btnCastFull"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/cast_full"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCastToggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/cast_start"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCastClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_close"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      两个勾选项（v3.20）。
      为什么单独放一行、不塞进顶栏：顶栏在封面屏上已经很挤（标题 + ⓘ + 开始投屏 + 关闭），
      再挤进去每一项都会变成小得点不着。放一行反而更好点，代价只是画面矮一点点。
    -->
    <LinearLayout
        android:id="@+id/rowCastOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbCastResize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#5AA9E6"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/cast_opt_resize"
            android:textColor="#B9C4D4"
            android:textSize="10sp" />

        <CheckBox
            android:id="@+id/cbCastZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:buttonTint="#5AA9E6"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/cast_opt_zoom"
            android:textColor="#B9C4D4"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 主场：左边画面（等比摆放、居中），右边一列"只按一下"的操作。
         ⚠ 顶上那 5dp 是给勾选行留的缝；全屏时它会被代码清成 0（见 CastActivity.setFullscreen），
           不然画面顶不到最上面、底下白白空一条。 -->
    <LinearLayout
        android:id="@+id/rowCastMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/mirrorBox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#05070A">

            <!-- 画面就贴在这儿。⚠ 它的宽高由代码按内屏比例算（见 CastActivity.fitMirror），
                 所以这里的 100dp 只是个占位，运行时会被换掉。 -->
            <TextureView
                android:id="@+id/mirrorView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />

            <!-- 没投屏时盖在画面上的那行提示 -->
            <TextView
                android:id="@+id/tvCastIdle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/cast_idle"
                android:textColor="#6C7889"
                android:textSize="11sp" />

            <!-- 全屏里的唯一出口（v4.32）：手指从画面最顶上往下拉，把它拉出来。
                 平时是收着的；只有全屏时才有机会出现（见 CastActivity.showExitBar）。 -->
            <Button
                android:id="@+id/btnCastExitFull"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/cast_exit_full"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/colCastOps"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnCastBack"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ext_back"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCastHome"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/ext_home"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCastRecent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/ext_btn"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/cast_recent"
                android:textAllCaps="false"
                android:textColor="#E6EAF2"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 注入走的哪条路（手势 / 输入）—— 跟触控板右下角那行一个用处：
                 用户一看就知道"为什么这次不跟手" -->
            <TextView
                android:id="@+id/tvCastPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="#6C7889"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 状态行：内屏尺寸 / 投屏状态 / 出错原因，一行说完 -->
    <TextView
        android:id="@+id/tvCastState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/cast_state_idle"
        android:textColor="#6C7889"
        android:textSize="10sp" />
</LinearLayout>
