<?xml version="1.0" encoding="utf-8"?>
<!--
  副屏桌面：投到封面屏（或便携屏）上的一块轻量桌面。
  故意用深色底 —— 封面屏小、又要长时间亮着，深色更省电也不刺眼。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#8C97A8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1D2531"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="—"
            android:textColor="#C8D2E0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHomeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="点图标即在本屏打开 · 底部可刷新 / 退出"
        android:textColor="#6C7889"
        android:textSize="10sp" />

    <GridView
        android:id="@+id/gvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:horizontalSpacing="2dp"
        android:numColumns="4"
        android:scrollbars="vertical"
        android:verticalSpacing="2dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="正在加载应用…"
        android:textColor="#8C97A8"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSHomeRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="刷新"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSHomeHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="系统桌面"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSHomeExit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="退出"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
