<?xml version="1.0" encoding="utf-8"?>
<!--
  「副屏播放器」（伪应用）的页面 —— 投到外屏上用的。

  ── 它是什么 ──────────────────────────────────────────────────
  不是播放器本体，是"接管系统里正在放的那个"：封面、歌名、歌手、歌词、进度、
  上一曲 / 播放暂停 / 下一曲。数据来自系统的 MediaSession，见 PlayerActivity 的类注释。

  ── 为什么这么排 ──────────────────────────────────────────────
  外屏可用面积约 352×339dp，要塞下封面 + 曲目信息 + 歌词 + 进度 + 三个按钮，
  所以封面固定 100dp、歌词那块吃掉全部剩余高度（layout_weight=1）、其余都是 wrap_content。
  ⚠ 别给歌词块写死高度：外屏上整体一超，底下那排按钮就被挤出屏幕。

  ── 配色 ──────────────────────────────────────────────────────
  整页深底（#FF0E0E12）跟状态展示柜一致 —— 副屏上多数时候是合盖随手看一眼，
  深底比白底耐看，也让封面那块更跳出来。
  ⚠ 关闭按钮写 × (U+00D7)：别换 ✕ (U+2715)，后者系统字体里可能没字形，按钮会隐形。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E12"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ext_player_title"
            android:textColor="#FFEDEDF2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="×"
            android:textColor="#FFEDEDF2"
            android:textSize="24sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/playerCover"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/player_cover_bg"
        android:contentDescription="@string/ext_player_title"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/playerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/player_idle_title"
        android:textColor="#FFF2F2F6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/playerArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/playerLyricPrev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#59FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/playerLyricNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerLyricNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#59FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/playerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/playerTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="--:-- / --:--"
        android:textColor="#80FFFFFF"
        android:textSize="11sp" />

    <SeekBar
        android:id="@+id/playerSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/playerPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_prev"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_prev" />

        <ImageButton
            android:id="@+id/playerPlay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_play"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_play" />

        <ImageButton
            android:id="@+id/playerNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_next"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_next" />
    </LinearLayout>
</LinearLayout>
