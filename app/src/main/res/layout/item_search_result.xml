<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索页的一条结果 —— 横排：图标在左、名字在右。

  ── 为什么不做成小格子 ──────────────────────────────────────────────
  搜索页会**自动把键盘叫出来**，而外屏只有 339dp 高、键盘占掉一半。
  用网格（一行四个小格子、行高 80dp 上下）时键盘一弹就只剩一行结果，
  搜什么都得滚，等于白搜。
  改成一行一条、行高 46dp 的紧凑列表，键盘上方能看仨 —— 这才是"搜完就点"的节奏。

  图标 34dp：比网格里的小，因为这里是"列表"，重心在字上。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="6dp"
    android:paddingRight="6dp">

    <ImageView
        android:id="@+id/srIcon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/srLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E8EDF5"
        android:textSize="14sp" />
</LinearLayout>
