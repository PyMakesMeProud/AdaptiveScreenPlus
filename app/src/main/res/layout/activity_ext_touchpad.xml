<?xml version="1.0" encoding="utf-8"?>
<!--
  副屏触控板（伪应用）的界面 —— 投在封面屏上用。

  ⚠ 尺寸按封面屏算：748×720px / d=1.5 ⇒ 约 498×414dp，
    再扣掉挖孔顶下来的 66px 和底部 33px，真正能用的大概 482×414dp。
    所以顶栏/底栏都压到 34/40dp，中间那块触摸面尽量让它大。
    （几何来历见 RULES §31.1；外屏上跑 Activity 时 density 是 1.5，别按 2.125 算。）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1116"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <!-- 顶栏：标题 + 灵敏度 + 关闭。
         高度写在行上、子项 match_parent（RULES §16.4），小按钮显式 minWidth=0。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvPadTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ext_pad_title"
            android:textColor="#E6EAF2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ⓘ：功能 / 用法 / 注意事项 全在这里，界面里不铺说明文字 -->
        <TextView
            android:id="@+id/iPadTop"
            style="@style/BetaInfoIcon"
            android:contentDescription="@string/ext_pad_title" />

        <Button
            android:id="@+id/btnPadSens"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_sens"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnPadClose"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="@string/ext_close"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 触摸面：一块纯手势面板，什么都不显示 ——
         光标不在这儿了，它在内屏上（见 CursorOverlay）。 -->
    <com.wb.extrotator.TouchpadView
        android:id="@+id/padView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_weight="1" />

    <!-- 底栏：四个"只按一下"的动作，省得每次都要先挪光标 -->
    <!-- 底栏：六个「只按一下」的动作，省得每次都要先把光标挪过去。
         v3.7 加了「◀ 翻页 / 翻页 ▶」—— 找应用时不用再拖着图标蹭到屏幕边缘等翻页，
         点一下翻一屏（双指左右滑也能翻）。六个挤一行，字号 13sp → 12sp、间距 5dp → 4dp。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPadClick"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_click"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadHold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_hold"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadPrevPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_page_prev"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadNextPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1.15"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_page_next"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_back"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPadHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/ext_btn"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/ext_home"
            android:textAllCaps="false"
            android:textColor="#E6EAF2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPadHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/ext_pad_hint"
        android:textColor="#6C7889"
        android:textSize="10sp" />
</LinearLayout>
