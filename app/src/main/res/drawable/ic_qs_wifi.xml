<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷开关图标：WiFi。两段同心圆弧 + 一个实心点，弧度由圆心算好（弧高 ≈ 弦长的一半）。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 外弧：(2.2,8.4) → (21.8,8.4)，r=14.5，圆心落在 (12,19.1) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:pathData="M2.2,8.4 A14.5,14.5 0 0 1 21.8,8.4" />

    <!-- 内弧：(6.4,13) → (17.6,13)，r=8.6，同一个圆心 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round"
        android:pathData="M6.4,13 A8.6,8.6 0 0 1 17.6,13" />

    <!-- 那一点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,17.6 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
