<?xml version="1.0" encoding="utf-8"?>
<!--
  计分器那块 LED 屏的底：近黑的深色 + 细白描边。

  刻度器（slotLedH/T/O）自己画的是亮红数码管，底必须够黑，红灯才"跳"得出来；
  用卡片那种 #E6212226 会发灰，红色看着闷。描边只是让它在深色卡片上仍有边界。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF0E0F12" />
    <corners android:radius="5dp" />
    <stroke
        android:width="1dp"
        android:color="#3DFFFFFF" />
</shape>
