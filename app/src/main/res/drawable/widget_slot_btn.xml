<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义模式下那三个快捷按钮的底。

  刻意跟摇奖格（widget_slot_cell，中性灰）**换个色调** —— 同一块组件上两套东西长得一样，
  用户会分不清现在是摇奖还是快捷键，按下去之前根本不知道会发生什么。偏青蓝一眼就能区分。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF22313C" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="#667FD4FF" />
</shape>
