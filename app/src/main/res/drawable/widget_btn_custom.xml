<?xml version="1.0" encoding="utf-8"?>
<!--
  「自定义操作」组件里四格的按钮底：青色圆角，四格同色。
  理由同 widget_btn_dual.xml（不用 <Button>，用 TextView + 背景）；
  统一一色（而不是按功能分色）—— 哪格是什么用户随时会改，颜色跟着功能走会显得像换了个东西。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF00838F" />
    <corners android:radius="12dp" />
</shape>
