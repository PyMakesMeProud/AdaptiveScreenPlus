<?xml version="1.0" encoding="utf-8"?>
<!--
  标题旁边那个「v2.3 · 更新说明」小胶囊。
  做成浅蓝底 + 蓝字，看着像"可以点"，但又不像按钮那样抢眼 —— 它只是入口。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#331565C0">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="#1A1565C0" />
            <stroke
                android:width="1dp"
                android:color="#401565C0" />
        </shape>
    </item>
</ripple>
